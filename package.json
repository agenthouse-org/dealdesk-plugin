{
  "name": "dealdesk-plugin",
  "version": "0.1.1",
  "description": "DealDesk for ChatGPT, Claude, Cursor, and Codex. Desk cards, quotes, customers, and portfolio on agenthouse.",
  "license": "MIT",
  "homepage": "https://github.com/agenthouse-org/dealdesk-plugin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/agenthouse-org/dealdesk-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/agenthouse-org/dealdesk-plugin/issues"
  },
  "keywords": [
    "agenthouse",
    "dealdesk",
    "plugin",
    "mcp",
    "model-context-protocol",
    "cursor",
    "claude",
    "chatgpt",
    "codex"
  ],
  "bin": {
    "dealdesk-plugin": "./bin/dealdesk-plugin.js",
    "dealdesk-mcp": "./bin/dealdesk-plugin.js"
  },
  "files": [
    "bin",
    "skills",
    "commands",
    "scripts",
    "assets",
    "plugin.json",
    "mcp.json",
    ".mcp.json",
    ".codex-plugin",
    ".claude-plugin",
    ".cursor-plugin",
    ".agents",
    "README.md",
    "LICENSE",
    "AGENTS.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "start": "node bin/dealdesk-plugin.js",
    "test": "node scripts/validate-skills.js && node scripts/test-project-scope.js && node scripts/package-plugin-zip.js",
    "package:zip": "node scripts/package-plugin-zip.js",
    "version:bump": "node scripts/bump-version.js"
  }
}
